{
  "name": "arushi",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Arushi - real-time voice assistant (Gemini Live audio in/out) with user-editable persona and safe device actions.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@google/genai": "^3.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.0",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
